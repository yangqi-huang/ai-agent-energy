    @output
    @render.ui
    def markdown_preview():

        content = input_value("editor_html") or markdown_to_editor_html(ai_output_result_value())

        return ui.HTML(content)

    @output
    @render.ui
    def uploaded_files_preview():
        files = input.upload()

        if not files:
            return ui.div(
                ui.tags.small("尚未上传文件。可一次选择多个 PPT / PDF / Word / 图片。"),
                class_="text-muted"
            )

        file_items = []
        for f in files:
            size = f.get("size")
            size_text = ""
            if size:
                size_text = f"（{size / 1024:.1f} KB）"
            file_items.append(ui.tags.li(f"{f.get('name', '未命名文件')} {size_text}"))

        return ui.div(
            ui.h6(f"已上传 {len(files)} 个文件"),
            ui.tags.ul(*file_items),
            ui.tags.small("Agent 会按文件名分段解析并合并进入同一份项目简报。"),
            class_="text-muted"
        )

