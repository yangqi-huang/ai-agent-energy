                ]:
                    add_research_item(enhanced_plan, seen_queries, {
                        "topic": "合作方背景定向搜索",
                        "query": f"{query} {suffix}",
                        "source_priority": "公司官网/年报/交易所公告/法院或制裁数据库/主流新闻",
                        "expected_evidence": "股权结构、财务状况、重大交易、诉讼制裁、负面新闻",
                        "search_type": "合作方尽调搜索",
                        "scoring_dimension": dimension,
                    })

            if any(word in combined for word in ["port", "terminal", "fsru", "pipeline", "power plant", "offtake", "industrial", "港口", "码头", "管网", "电厂", "工业园", "消纳"]):
                for suffix in [
                    "port terminal capacity official",
                    "LNG terminal FSRU capacity",
                    "pipeline power plant industrial demand",
                    "offtake agreement gas sales",
                ]:
                    add_research_item(enhanced_plan, seen_queries, {
                        "topic": "基础设施/消纳定向搜索",
                        "query": f"{query} {suffix}",
                        "source_priority": "港口官网/项目公司/监管公告/能源专业媒体",
                        "expected_evidence": "港口、码头、储罐、管网、电厂、工业客户、offtake安排",
                        "search_type": "基础设施和消纳搜索",
                        "scoring_dimension": "基础设施成熟度 / 市场消纳",
                    })

        # 控制搜索量，避免网页抓取过慢和最终prompt过长。
        return enhanced_plan[:28]

