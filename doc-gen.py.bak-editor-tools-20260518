    def set_cell_text(cell, text: str, bold: bool = False):
        cell.text = ""
        paragraph = cell.paragraphs[0]
        paragraph.paragraph_format.space_after = Pt(0)
        run = paragraph.add_run(text.strip())
        run.bold = bold
        run.font.size = Pt(9)
        for paragraph in cell.paragraphs:
            for run in paragraph.runs:
                run.font.name = "Arial"
                run._element.rPr.rFonts.set(qn("w:eastAsia"), "Microsoft YaHei")
        cell.vertical_alignment = WD_CELL_VERTICAL_ALIGNMENT.CENTER

    def shade_cell(cell, fill: str):
        tc_pr = cell._tc.get_or_add_tcPr()
        shd = OxmlElement("w:shd")
        shd.set(qn("w:fill"), fill)
        tc_pr.append(shd)

    def set_table_borders(table):
        tbl = table._tbl
        tbl_pr = tbl.tblPr
        borders = OxmlElement("w:tblBorders")
        for border_name in ["top", "left", "bottom", "right", "insideH", "insideV"]:
            border = OxmlElement(f"w:{border_name}")
            border.set(qn("w:val"), "single")
            border.set(qn("w:sz"), "4")
            border.set(qn("w:space"), "0")
            border.set(qn("w:color"), "D9E2EC")
            borders.append(border)
        tbl_pr.append(borders)

    def add_markdown_runs(paragraph, text: str):
        """
        支持简单 **加粗**；其余 Markdown 标记保留为普通文本。
        """

        parts = re.split(r"(\*\*.*?\*\*)", text)
        for part in parts:
            if not part:
                continue
            run_text = part[2:-2] if part.startswith("**") and part.endswith("**") else part
            run = paragraph.add_run(run_text)
            run.bold = part.startswith("**") and part.endswith("**")
            run.font.name = "Arial"
            run._element.rPr.rFonts.set(qn("w:eastAsia"), "Microsoft YaHei")

    def is_markdown_table(lines: list[str], idx: int) -> bool:
        if idx + 1 >= len(lines):
            return False
        current = lines[idx].strip()
        separator = lines[idx + 1].strip()
        return (
            current.startswith("|")
            and current.endswith("|")
            and separator.startswith("|")
            and separator.endswith("|")
            and re.fullmatch(r"\|[\s:\-|\u3000]+\|", separator) is not None
        )

    def parse_table_row(line: str) -> list[str]:
        return [cell.strip() for cell in line.strip().strip("|").split("|")]

    def add_markdown_table(doc: Document, table_lines: list[str]):
        rows = [parse_table_row(line) for line in table_lines if line.strip()]
        if len(rows) < 2:
            return

        header = rows[0]
        body = rows[2:]
        col_count = len(header)
        table = doc.add_table(rows=1, cols=col_count)
        table.alignment = WD_TABLE_ALIGNMENT.CENTER
        table.autofit = True
        set_table_borders(table)

        for col_idx, title in enumerate(header):
            cell = table.rows[0].cells[col_idx]
            set_cell_text(cell, title, bold=True)
            shade_cell(cell, "EAF2F8")

        for row in body:
            cells = table.add_row().cells
            for col_idx in range(col_count):
                text = row[col_idx] if col_idx < len(row) else ""
                set_cell_text(cells[col_idx], text)

        doc.add_paragraph()

    def add_html_table(doc: Document, rows: list[list[dict]]):
        if not rows:
            return

        col_count = max(len(row) for row in rows)
        if col_count == 0:
            return

        table = doc.add_table(rows=1, cols=col_count)
        table.alignment = WD_TABLE_ALIGNMENT.CENTER
        table.autofit = True
        set_table_borders(table)

        for col_idx in range(col_count):
            cell_data = rows[0][col_idx] if col_idx < len(rows[0]) else {"text": "", "header": True}
            cell = table.rows[0].cells[col_idx]
            set_cell_text(cell, cell_data.get("text", ""), bold=True)
            shade_cell(cell, "EAF2F8")

        for row in rows[1:]:
            cells = table.add_row().cells
            for col_idx in range(col_count):
                cell_data = row[col_idx] if col_idx < len(row) else {"text": "", "header": False}
                set_cell_text(cells[col_idx], cell_data.get("text", ""))

        doc.add_paragraph()

    def style_word_document(doc: Document):
        section = doc.sections[0]
        section.top_margin = Inches(0.8)
        section.bottom_margin = Inches(0.8)
        section.left_margin = Inches(0.85)
        section.right_margin = Inches(0.85)

        styles = doc.styles
        normal = styles["Normal"]
        normal.font.name = "Arial"
        normal._element.rPr.rFonts.set(qn("w:eastAsia"), "Microsoft YaHei")
        normal.font.size = Pt(10.5)
        normal.paragraph_format.line_spacing = 1.2
        normal.paragraph_format.space_after = Pt(6)

        for style_name, size, color in [
            ("Title", 20, "17365D"),
            ("Heading 1", 15, "17365D"),
            ("Heading 2", 12.5, "1F4E79"),
            ("Heading 3", 11.5, "335C67"),
        ]:
            style = styles[style_name]
            style.font.name = "Arial"
            style._element.rPr.rFonts.set(qn("w:eastAsia"), "Microsoft YaHei")
            style.font.size = Pt(size)
            style.font.bold = True
            style.font.color.rgb = RGBColor.from_string(color)
            style.paragraph_format.space_before = Pt(10)
            style.paragraph_format.space_after = Pt(6)

    def markdown_to_docx_bytes(markdown_text: str) -> bytes:
        doc = Document()
        style_word_document(doc)

        title = "项目简报"
        for line in markdown_text.splitlines():
            if line.strip().startswith("# "):
                title = line.strip().lstrip("#").strip()
                break

        doc.core_properties.title = title
        doc.core_properties.author = "广东九丰能源项目简报信息排版AI Agent"
        doc.core_properties.created = datetime.now()

        title_paragraph = doc.add_paragraph(style="Title")
        title_paragraph.alignment = WD_ALIGN_PARAGRAPH.CENTER
        title_paragraph.add_run(title)

        meta = doc.add_paragraph()
        meta.alignment = WD_ALIGN_PARAGRAPH.CENTER
        meta_run = meta.add_run(f"生成时间：{datetime.now().strftime('%Y-%m-%d %H:%M')}")
        meta_run.font.size = Pt(9)
        meta_run.font.color.rgb = RGBColor.from_string("667085")

        lines = markdown_text.splitlines()
        idx = 0
        while idx < len(lines):
            line = lines[idx].rstrip()
            stripped = line.strip()

            if not stripped:
                idx += 1
                continue

            if is_markdown_table(lines, idx):
                table_lines = [lines[idx], lines[idx + 1]]
                idx += 2
                while idx < len(lines) and lines[idx].strip().startswith("|"):
                    table_lines.append(lines[idx])
                    idx += 1
                add_markdown_table(doc, table_lines)
                continue

            if stripped.startswith("#"):
                level = len(stripped) - len(stripped.lstrip("#"))
                heading_text = stripped.lstrip("#").strip()
                if heading_text == title:
                    idx += 1
                    continue
                doc.add_heading(heading_text, level=min(level, 3))
                idx += 1
                continue

            bullet_match = re.match(r"^[-*]\s+(.+)$", stripped)
            if bullet_match:
                paragraph = doc.add_paragraph(style="List Bullet")
                add_markdown_runs(paragraph, bullet_match.group(1))
                idx += 1
                continue

            numbered_match = re.match(r"^\d+[.)]\s+(.+)$", stripped)
            if numbered_match:
                paragraph = doc.add_paragraph(style="List Number")
                add_markdown_runs(paragraph, numbered_match.group(1))
                idx += 1
                continue

            paragraph = doc.add_paragraph()
            add_markdown_runs(paragraph, stripped)
            idx += 1

        buffer = BytesIO()
        doc.save(buffer)
        return buffer.getvalue()

    class RichHtmlToDocxParser(HTMLParser):
        def __init__(self, doc: Document):
            super().__init__()
            self.doc = doc
            self.current_paragraph = None
            self.bold = False
            self.italic = False
            self.underline = False
            self.list_stack = []
            self.in_table = False
            self.table_rows = []
            self.current_row = None
            self.current_cell = None

        def handle_starttag(self, tag, attrs):
            tag = tag.lower()

            if tag in ["strong", "b"]:
                self.bold = True
            elif tag in ["em", "i"]:
                self.italic = True
            elif tag == "u":
                self.underline = True
            elif tag in ["h1", "h2", "h3"]:
                level = int(tag[1])
                self.current_paragraph = self.doc.add_heading("", level=level)
            elif tag in ["p", "div"]:
                if not self.in_table:
                    self.current_paragraph = self.doc.add_paragraph()
            elif tag == "br":
                if self.current_paragraph is not None:
                    self.current_paragraph.add_run().add_break()
            elif tag == "ul":
                self.list_stack.append("ul")
            elif tag == "ol":
                self.list_stack.append("ol")
            elif tag == "li":
                style = "List Number" if self.list_stack and self.list_stack[-1] == "ol" else "List Bullet"
                self.current_paragraph = self.doc.add_paragraph(style=style)
            elif tag == "table":
                self.in_table = True
                self.table_rows = []
            elif tag == "tr":
                self.current_row = []
            elif tag in ["th", "td"]:
                self.current_cell = {
                    "text": "",
                    "header": tag == "th"
                }

        def handle_endtag(self, tag):
            tag = tag.lower()

            if tag in ["strong", "b"]:
                self.bold = False
            elif tag in ["em", "i"]:
                self.italic = False
            elif tag == "u":
                self.underline = False
            elif tag in ["h1", "h2", "h3", "p", "div", "li"]:
                self.current_paragraph = None
            elif tag in ["ul", "ol"]:
                if self.list_stack:
                    self.list_stack.pop()
            elif tag in ["th", "td"]:
                if self.current_row is not None and self.current_cell is not None:
                    self.current_cell["text"] = re.sub(r"\s+", " ", self.current_cell["text"]).strip()
                    self.current_row.append(self.current_cell)
                self.current_cell = None
            elif tag == "tr":
                if self.current_row is not None:
                    self.table_rows.append(self.current_row)
                self.current_row = None
            elif tag == "table":
                add_html_table(self.doc, self.table_rows)
                self.in_table = False
                self.table_rows = []

        def handle_data(self, data):
            if not data:
                return

            if self.in_table and self.current_cell is not None:
                self.current_cell["text"] += data
                return

            text = data
            if not text.strip():
                return

            if self.current_paragraph is None:
                self.current_paragraph = self.doc.add_paragraph()

            run = self.current_paragraph.add_run(text)
            run.bold = self.bold
            run.italic = self.italic
            run.underline = self.underline
            run.font.name = "Arial"
            run._element.rPr.rFonts.set(qn("w:eastAsia"), "Microsoft YaHei")

    def html_to_docx_bytes(html_text: str) -> bytes:
        doc = Document()
        style_word_document(doc)

        doc.core_properties.title = "项目简报"
        doc.core_properties.author = "广东九丰能源项目简报信息排版AI Agent"
        doc.core_properties.created = datetime.now()

        parser = RichHtmlToDocxParser(doc)
        parser.feed(html_text or "<h1>项目简报</h1><p>暂无AI输出内容。</p>")

        buffer = BytesIO()
        doc.save(buffer)
        return buffer.getvalue()

