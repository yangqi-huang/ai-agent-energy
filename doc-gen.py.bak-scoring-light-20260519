            peripheral_plan = build_peripheral_search_plan(peripheral_clues)
            research_plan = build_enhanced_research_plan(base_research_plan + peripheral_plan)

            p.set(50, message="正在联网搜索补充信息...")

            search_result_text = ""

            # ======================================
