        return parse_json_object(result["choices"][0]["message"]["content"])

    def build_peripheral_search_plan(clues: dict) -> list[dict]:
        country = str(clues.get("country", "") or "").strip()
        region = str(clues.get("region", "") or "").strip()
        project_name = str(clues.get("project_name", "") or "").strip()
        locations = normalize_clue_list(clues.get("cities_or_locations"))
        companies = normalize_clue_list(clues.get("companies"))
        people = normalize_clue_list(clues.get("shareholders_or_people"))
