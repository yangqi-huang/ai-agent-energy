    def preprocess_ocr_image(image_bytes: bytes) -> BytesIO:
        image = Image.open(BytesIO(image_bytes))
        image = ImageOps.exif_transpose(image)
        image = image.convert("L")

        width, height = image.size
        max_side = max(width, height)
        if max_side < 1800:
            scale = min(3, 1800 / max_side)
            image = image.resize(
                (int(width * scale), int(height * scale)),
                Image.Resampling.LANCZOS
            )

        image = ImageEnhance.Contrast(image).enhance(1.8)
        image = ImageOps.autocontrast(image)

        output = BytesIO()
        image.save(output, format="PNG")
        output.seek(0)
        return output

    def ocr_image_bytes(image_bytes: bytes, lang: str = "chi_sim+eng") -> tuple[str, str | None]:
        """
        OCR优先级：
        1. pytesseract Python包
        2. tesseract 命令行

        返回：(识别文本, 错误信息)。如果没有OCR引擎，错误信息会说明安装方式。
        """

        try:
            processed = preprocess_ocr_image(image_bytes)
        except Exception as e:
            return "", f"图片预处理失败：{str(e)}"

        try:
            import pytesseract

            text = pytesseract.image_to_string(
                Image.open(processed),
                lang=lang,
                config="--psm 6"
            )
            return text.strip(), None
        except Exception as py_error:
            tesseract_cmd = shutil.which("tesseract")
            if not tesseract_cmd:
                return "", (
                    "OCR不可用：未检测到 pytesseract 或 tesseract。"
                    "如需识别PPT/图片里的文字，请安装：brew install tesseract tesseract-lang；"
                    "并在虚拟环境中安装 pytesseract。"
                )

            with tempfile.NamedTemporaryFile(suffix=".png") as image_file:
                image_file.write(processed.getvalue())
                image_file.flush()

                try:
                    completed = subprocess.run(
                        [
                            tesseract_cmd,
                            image_file.name,
                            "stdout",
                            "-l",
                            lang,
                            "--psm",
                            "6",
                        ],
                        check=True,
                        capture_output=True,
                        text=True,
                        timeout=45
                    )
                    return completed.stdout.strip(), None
                except Exception as cli_error:
                    return "", f"OCR失败：pytesseract错误：{py_error}；tesseract命令错误：{cli_error}"

    def extract_docx_tables(doc: Document) -> str:
        text = ""
        for table_idx, table in enumerate(doc.tables, start=1):
            text += f"\n【Word表格 {table_idx}】\n"
            for row in table.rows:
                cells = [cell.text.strip().replace("\n", " ") for cell in row.cells]
                if any(cells):
                    text += " | ".join(cells) + "\n"
        return text

    def extract_ppt_table_text(shape) -> str:
        if not getattr(shape, "has_table", False):
            return ""

        text = ""
        table = shape.table
        for row in table.rows:
            cells = [cell.text.strip().replace("\n", " ") for cell in row.cells]
            if any(cells):
                text += " | ".join(cells) + "\n"
        return text

    def extract_ppt_notes(slide) -> str:
        try:
            notes_text = slide.notes_slide.notes_text_frame.text
            return notes_text.strip()
        except Exception:
            return ""

    def extract_ppt_image_ocr(shape, slide_idx: int, image_idx: int) -> str:
        try:
            image = shape.image
            text, error = ocr_image_bytes(image.blob)
            if text:
                return f"\n【PPT第{slide_idx}页 图片{image_idx} OCR】\n{text}\n"
            if error:
                return f"\n【PPT第{slide_idx}页 图片{image_idx}】检测到图片，但{error}\n"
            return ""
        except Exception as e:
            return f"\n【PPT第{slide_idx}页 图片{image_idx}】图片OCR读取失败：{str(e)}\n"

    def parse_pptx(file_path: str) -> str:
        prs = Presentation(file_path)
        text = ""

        for slide_idx, slide in enumerate(prs.slides, start=1):
            slide_text = ""
            image_idx = 0

            for shape in slide.shapes:
                if hasattr(shape, "text") and shape.text:
                    slide_text += shape.text.strip() + "\n"

                table_text = extract_ppt_table_text(shape)
                if table_text:
                    slide_text += f"\n【PPT第{slide_idx}页 表格】\n{table_text}"

                if getattr(shape, "shape_type", None) == MSO_SHAPE_TYPE.PICTURE or hasattr(shape, "image"):
                    image_idx += 1
                    slide_text += extract_ppt_image_ocr(shape, slide_idx, image_idx)

            notes_text = extract_ppt_notes(slide)
            if notes_text:
                slide_text += f"\n【PPT第{slide_idx}页 备注】\n{notes_text}\n"

            if slide_text.strip():
                text += f"\n【PPT第{slide_idx}页】\n{slide_text}\n"

        return text

    def parse_file(file_path: str, file_name: str):

        ext = Path(file_name).suffix.lower()
        text = ""

        try:

            # PDF
            if ext == ".pdf":

                reader = PdfReader(file_path)

                for page in reader.pages:

                    t = page.extract_text()

                    if t:
                        text += t + "\n\n"

            # Word
            elif ext == ".docx":

                doc = Document(file_path)

                for para in doc.paragraphs:
                    text += para.text + "\n"

                text += extract_docx_tables(doc)

            # PPT
            elif ext == ".pptx":

                text += parse_pptx(file_path)

            # 图片
            elif ext in [".png", ".jpg", ".jpeg"]:

                text += f"【图片文件】{file_name}\n"
                image_bytes = Path(file_path).read_bytes()
                ocr_text, ocr_error = ocr_image_bytes(image_bytes)
                if ocr_text:
                    text += f"【图片OCR】\n{ocr_text}\n"
                else:
                    text += f"{ocr_error or '未识别到图片文字'}\n"

            else:

                text += f"不支持的文件类型：{ext}\n"

        except Exception as e:

            text += f"解析失败：{str(e)}\n"

        return text

