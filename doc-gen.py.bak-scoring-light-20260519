    def add_research_item(items: list[dict], seen_queries: set[str], item: dict):
        query = item.get("query", "").strip()
        if not query:
            return

        normalized = re.sub(r"\s+", " ", query.lower())
        if normalized in seen_queries:
            return

        seen_queries.add(normalized)
        items.append({
            "topic": item.get("topic", "综合研究"),
            "query": query,
            "source_priority": item.get("source_priority", "官方/行业/新闻"),
            "expected_evidence": item.get("expected_evidence", "事实、数据、出处"),
            "search_type": item.get("search_type", "AI生成研究计划"),
            "scoring_dimension": item.get("scoring_dimension", "综合判断"),
        })

